import { Button, VerticalBox, LineEdit, HorizontalBox, ScrollView, ComboBox } from "std-widgets.slint";

export struct Data {
    id: int,
    name: string,
    message: string,
}

export component CustomButton inherits Rectangle {
    in property <string> text;
    in property <color> base-color;
    in property <color> hover-color;
    in property <color> click-color;
    callback clicked;

    background: touch.pressed ? root.click-color : touch.has-hover ? root.hover-color : root.base-color;
    border-radius: 8px;
    border-width: 1px;
    border-color: black;

    Text { 
        text: root.text; 
        color: white; 
        font-weight: 800;
    }
    touch := TouchArea { clicked => { clicked() } }
}

export component Node inherits Rectangle {
    in property <int> id;
    in property <string> name;
    in property <string> message;


    background: white;
    border-radius: 10px;
    border-width: 1px;
    border-color: #adadad;
    width: 200px;
    height: 100px;
    drop-shadow-blur: 8px;
    drop-shadow-color: rgba(0,0,0,0.1);


    VerticalBox {
        padding: 8px;
        spacing: 0px;
        Rectangle {
            HorizontalBox {
                Text {
                    text: message;
                    font-size: 12px;
                    color: #666;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            HorizontalBox {

                Rectangle {
                    background: #1653e2;
                    width: 30px;
                    height: 30px;
                    border-radius: 8px;
                    Text {
                        text: id;
                        font-size: 12px;
                        font-weight: 600;
                        color: white;
                    }
                }

                HorizontalBox {
                    Text {
                        text: name;
                        font-size: 12px;
                        font-weight: 800;
                        color: #333;
                    }
                }

                CustomButton {
                    width: 30px;
                    height: 30px;
                    text: "X";
                    
                    base-color: #ff3d3d;
                    hover-color: #ff2d2d;
                    click-color: #ff0000;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "LinkList Manager";
    min-width: 1280px;
    min-height: 720px;
    background: #f8f9fa;

    property <[Data]> nodes: [
        { id: 1, name: "User1", message: "Yo" },
        { id: 2, name: "User2", message: "Hello" },
        { id: 3, name: "User1", message: "Hello User 2" },
    ];
    
    //Main Box
    VerticalBox {
        padding: 24px;
        spacing: 20px;

        // Header
        Text {
            text: "Linked List Manager";
            font-size: 24px;
            font-weight: 800;
            color: #1a1a1a;
            horizontal-alignment: center;
        }

        //Insert Node Section
        Rectangle {
            background: white;
            border-radius: 12px;
            border-width: 1px;
            border-color: #adadad;
            height: 210px;

            //Input Fields
            VerticalBox {
                Text {
                    text: "Insert New Node";
                    font-size: 16px;
                    font-weight: 600;
                    color: #333;
                    horizontal-alignment: center;
                }

                HorizontalBox {
                    spacing: 12px;
                    LineEdit {
                        placeholder-text: "UserName";
                        font-size: 14px;
                    }
                    LineEdit {
                        placeholder-text: "Message";
                        font-size: 14px;
                    }
                }

                Button {
                    text: "Insert Node";
                    primary: true;
                    height: 35px;
                }

                HorizontalBox {
                    spacing: 12px;
                    Text {
                        text: "Select Category: ";
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: [
                            "Insert At Beginning",
                            "Insert At End",
                            "Insert At A Position"
                        ];
                        current-index: 0;
                    }
                }
            }
        }

        Rectangle {
            background: white;
            border-radius: 12px;
            border-width: 1px;
            border-color: #adadad;
            height: 132px; 

            ScrollView {
                HorizontalBox {
                    alignment: start;
                    spacing: 0;

                    for node[i] in root.nodes : HorizontalBox {
                        spacing: 0;
                        alignment: center;

                        Node {
                            id: node.id;
                            name: node.name;
                            message: node.message;
                        }
                    }
                }
            }
        }

    }
}
